# Application
DATABASE_URL=postgresql+asyncpg://certuser:certpass@localhost:5432/certdb
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_ROOT=storage

# Limits
MAX_RECIPIENTS_PER_JOB=500
BATCH_SIZE=50

# Certificate fonts
# Leave empty to use the bundled Helvetica fallback
CERTIFICATE_FONT_PATH=

# Logging
LOG_LEVEL=INFO
